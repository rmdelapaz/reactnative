{
  "title": "The check-in desk: a button for a finger, a number field, a switch, taps with the keyboard open",
  "lesson": "2.4",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "Tests:       7 failed, 7 total"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": "nonzero",
      "expect": [
        "error TS18048: 'event.target' is possibly 'undefined'.",
        "error TS2551: Property 'value' does not exist",
        "error TS2322"
      ]
    },
    {
      "name": "as-shipped-lint",
      "dir": "starter",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       7 passed, 7 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution-web",
      "dir": "solution",
      "cmd": "npx expo export --platform web --output-dir dist --clear",
      "exit": 0,
      "expect": [
        "Exported: dist"
      ],
      "timeout": 300
    }
  ]
}
