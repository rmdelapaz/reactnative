{
  "title": "Gesture Handler 3: far or fast, onDeactivate, and a button for every swipe",
  "lesson": "7.2",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "Tests:       4 failed, 2 passed, 6 total"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": "nonzero",
      "expect": [
        "error TS2353",
        "'onEnd' does not exist in type"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       6 passed, 6 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution-web",
      "dir": "solution",
      "cmd": "npx expo export --platform web --output-dir dist --clear",
      "exit": 0,
      "timeout": 300,
      "expect": [
        "Exported: dist"
      ]
    }
  ]
}
