{
  "title": "Reanimated 4: a CSS-style transition, Reduce Motion for a keyframe loop, a count that lands",
  "lesson": "7.1",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "Tests:       5 failed, 3 passed, 8 total"
      ]
    },
    {
      "name": "shipped-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "starter-lint",
      "dir": "starter",
      "cmd": "npm run lint",
      "exit": "nonzero",
      "expect": [
        "react-hooks/immutability",
        "1 problem (1 error, 0 warnings)"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       8 passed, 8 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution-web",
      "dir": "solution",
      "cmd": "npx expo export --platform web --output-dir dist --clear",
      "exit": 0,
      "timeout": 300,
      "expect": [
        "Exported: dist"
      ]
    }
  ]
}
