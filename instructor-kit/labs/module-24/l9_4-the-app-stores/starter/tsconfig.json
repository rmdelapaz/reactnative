{
  // Plain TypeScript on Node (no React Native): strict, Node runs the .ts files directly (type stripping).
  // TypeScript 6.0, the version Expo SDK 58 pins (the HQ course used 7.0: the same rules apply here)
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
