{
  "title": "Shoreline Lookout's app config: variants, a guard, a key from the environment",
  "lesson": "9.1",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "Tests:       6 failed, 6 total"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": "nonzero",
      "expect": [
        "error TS2561",
        "Did you mean to write 'package'?"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       6 passed, 6 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution-config-dev",
      "dir": "solution",
      "cmd": "npx expo config --type public",
      "exit": 0,
      "expect": [
        "name: 'Lookout Dev'",
        "scheme: 'shorelinelookout-dev'",
        "package: 'com.example.shorelinelookout.dev'"
      ]
    },
    {
      "name": "solution-config-preview",
      "dir": "solution",
      "cmd": "APP_VARIANT=preview npx expo config --type public",
      "exit": 0,
      "expect": [
        "name: 'Lookout Preview'",
        "bundleIdentifier: 'com.example.shorelinelookout.preview'"
      ]
    },
    {
      "name": "variant-typo",
      "dir": "solution",
      "cmd": "APP_VARIANT=Preview npx expo config --type public",
      "exit": "nonzero",
      "expect": [
        "APP_VARIANT must be development, preview or production, not \"Preview\"."
      ]
    },
    {
      "name": "production-http",
      "dir": "solution",
      "cmd": "APP_VARIANT=production EXPO_PUBLIC_API_URL=http://lookout-api.example.org npx expo config --type public",
      "exit": "nonzero",
      "expect": [
        "A production build needs an https:// EXPO_PUBLIC_API_URL, not \"http://lookout-api.example.org\"."
      ]
    },
    {
      "name": "solution-introspect",
      "dir": "solution",
      "cmd": "APP_VARIANT=preview npx expo config --type introspect | grep -E \"CFBundleDisplayName|NSLocationWhenInUseUsageDescription\"",
      "exit": 0,
      "expect": [
        "CFBundleDisplayName: 'Lookout Preview'",
        "Shoreline Lookout uses your location to show the beach nearest to you."
      ]
    }
  ]
}
