{
  "title": "From the HQ to the phone: browser APIs tsc accepts, the phone's fetch error, the address the Expo way",
  "lesson": "1.3",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "window",
        "sessionStorage",
        "Tests:       3 failed, 5 passed, 8 total"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": 0,
      "expect": [
        "> tsc --noEmit"
      ],
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "starter-search",
      "dir": "starter",
      "cmd": "grep -n -E 'window|document|Storage|import\\.meta' src/shared/*.ts src/api/*.ts src/utils/*.ts",
      "exit": 0,
      "expect": [
        "window.location.origin",
        "sessionStorage.getItem"
      ]
    },
    {
      "name": "starter-lint",
      "dir": "starter",
      "cmd": "npm run lint",
      "exit": "nonzero",
      "expect": [
        "expo/no-env-var-destructuring",
        "1 problem (1 error, 0 warnings)"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       8 passed, 8 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution-search",
      "dir": "solution",
      "cmd": "grep -n -E 'window|document|Storage|import\\.meta' src/shared/*.ts src/api/*.ts src/utils/*.ts || echo 'no browser APIs found'",
      "exit": 0,
      "expect": [
        "no browser APIs found"
      ]
    },
    {
      "name": "solution-web",
      "dir": "solution",
      "cmd": "npx expo export --platform web --output-dir dist --clear",
      "exit": 0,
      "expect": [
        "Exported: dist"
      ],
      "timeout": 300
    }
  ]
}
