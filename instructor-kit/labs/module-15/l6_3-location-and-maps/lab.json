{
  "title": "The supply van: a position as a circle, a map with a web stand-in, a pickup code kept as text",
  "lesson": "6.3",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "Tests:       8 failed, 5 passed, 13 total"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": "nonzero",
      "expect": [
        "error TS2322",
        "Type 'unknown' is not assignable to type 'string | undefined'."
      ]
    },
    {
      "name": "starter-web",
      "dir": "starter",
      "cmd": "npx expo export --platform web --output-dir dist --clear && node web-check.mjs",
      "exit": "nonzero",
      "timeout": 300,
      "expect": [
        "codegenNativeComponent) is not a function"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       13 passed, 13 total"
      ]
    },
    {
      "name": "solution-web",
      "dir": "solution",
      "cmd": "npx expo export --platform web --output-dir dist --clear && node web-check.mjs",
      "exit": 0,
      "timeout": 300,
      "expect": [
        "Exported: dist",
        "The web bundle loads without an error."
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    }
  ]
}
