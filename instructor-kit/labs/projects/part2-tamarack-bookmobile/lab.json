    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution-web",
