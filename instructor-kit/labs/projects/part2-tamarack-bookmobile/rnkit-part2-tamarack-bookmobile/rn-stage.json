{
  "lesson": "part2-tamarack-bookmobile",
  "api": {
    "dir": "bookmobile-api",
    "args": [
      "--quiet"
    ]
  },
  "apps": {
    "bookmobile-stops": {
      "env": {
        "EXPO_PUBLIC_API_URL": "{API}"
      },
      "lint_warnings": 0,
      "platforms": [
        "web",
        "android",
        "ios"
      ]
    }
  },
  "checks": [
    {
      "app": "bookmobile-stops",
      "name": "api-stops",
      "base": "{API}",
      "path": "/api/stops/s03",
      "request": {
        "method": "GET"
      },
      "contains": [
        "\"name\":\"Pine Hollow Elementary\"",
        "\"day\":\"tuesday\""
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "api-holds-guest",
      "base": "{API}",
      "path": "/api/holds",
      "request": {
        "method": "POST",
        "json": {
          "clientId": "x",
          "bookId": "b01",
          "stopId": "s01"
        }
      },
      "status": 401,
      "contains": [
        "Sign in to see and place holds."
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "stops",
      "path": "/",
      "expect": [
        "Stops",
        "Nearest stop",
        "Find my nearest stop",
        "8 stops this week",
        "Larch Creek Trailhead",
        "Mondays, 10:00 AM to 11:30 AM",
        "Millrace Green Story Corner",
        "Books",
        "Holds",
        "Account"
      ],
      "selectors": {
        "[role='heading']": true,
        "[role='tab']": 4,
        "[aria-label='Open Pine Hollow Elementary']": 1
      },
      "absent": [
        "Loading stops",
        "My stop",
        "(tabs)",
        "TODO"
      ],
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "stop-by-address",
      "path": "/stops/s02",
      "expect": [
        "When: Mondays, 2:00 PM to 3:30 PM",
        "Where: 410 Ridgeline Drive, Cedar Bend",
        "Make this my stop"
      ],
      "selectors": {
        "role=heading[name='Ridgeline Senior Center']": true
      },
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "stop-unknown",
      "path": "/stops/s99",
      "allow_errors": [
        "404"
      ],
      "expect": [
        "No stop with that id. Check the link.",
        "See all stops"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "not-found",
      "path": "/nowhere",
      "allow_errors": [
        "404"
      ],
      "expect": [
        "This page is not on the bookmobile's route."
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "my-stop-saved",
      "path": "/",
      "storage": {
        "bookmobile-settings": "{\"myStopId\":\"s04\"}"
      },
      "expect": [
        "My stop"
      ],
      "selectors": {
        "text='My stop'": 1
      }
    },
    {
      "app": "bookmobile-stops",
      "name": "my-stop-bad-saved",
      "path": "/account",
      "storage": {
        "bookmobile-settings": "{not json"
      },
      "expect": [
        "No stop chosen yet. Pick one on the Stops tab."
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "books-search",
      "path": "/books",
      "actions": [
        {
          "fill": [
            "input[aria-label='Search books']",
            "fox"
          ]
        }
      ],
      "expect": [
        "1 book",
        "Moss and the Midnight Fox",
        "Teodor Banks · Children",
        "On the van"
      ],
      "absent": [
        "Pancake Weather"
      ],
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "holds-guest",
      "path": "/holds",
      "expect": [
        "Sign in to see and place holds."
      ],
      "absent": [
        "Your holds"
      ],
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "sign-in-wrong-pin",
      "path": "/holds",
      "allow_errors": [
        "401"
      ],
      "actions": [
        {
          "click": "role=link[name='Sign in']",
          "wait": 1500
        },
        {
          "fill": [
            "input[aria-label='Library card number']",
            "2145 0021"
          ]
        },
        {
          "fill": [
            "input[aria-label='PIN']",
            "0000"
          ]
        },
        {
          "click": "role=button[name='Sign in']",
          "wait": 2500
        }
      ],
      "expect": [
        "That card number and PIN do not match our records."
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "holds-signed-in",
      "path": "/holds",
      "actions": [
        {
          "click": "role=link[name='Sign in']",
          "wait": 1500
        },
        {
          "fill": [
            "input[aria-label='Library card number']",
            "2145 0021"
          ]
        },
        {
          "fill": [
            "input[aria-label='PIN']",
            "4821"
          ]
        },
        {
          "click": "role=button[name='Sign in']",
          "wait": 2500
        }
      ],
      "expect": [
        "Your holds",
        "A History of Tamarack County",
        "Pick up at Ridgeline Senior Center",
        "Ready at the stop"
      ],
      "absent": [
        "Sign in to see and place holds."
      ],
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "place-hold",
      "path": "/holds",
      "height": 1600,
      "actions": [
        {
          "click": "role=link[name='Sign in']",
          "wait": 1500
        },
        {
          "fill": [
            "input[aria-label='Library card number']",
            "2145 0021"
          ]
        },
        {
          "fill": [
            "input[aria-label='PIN']",
            "4821"
          ]
        },
        {
          "click": "role=button[name='Sign in']",
          "wait": 2500
        },
        {
          "click": "role=tab[name=/Books/]",
          "wait": 1500
        },
        {
          "click": "[aria-label='Place a hold on The Quiet Orchard']",
          "wait": 1500
        },
        {
          "click": "role=button[name='Place hold']",
          "wait": 800
        }
      ],
      "expect": [
        "Note for the librarian (optional)",
        "Choose the stop where you will pick it up."
      ],
      "selectors": {
        "role=radiogroup[name='Pick up at'] >> role=radio": 8
      },
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "place-hold-sent",
      "path": "/holds",
      "height": 1600,
      "actions": [
        {
          "click": "role=link[name='Sign in']",
          "wait": 1500
        },
        {
          "fill": [
            "input[aria-label='Library card number']",
            "2145 0021"
          ]
        },
        {
          "fill": [
            "input[aria-label='PIN']",
            "4821"
          ]
        },
        {
          "click": "role=button[name='Sign in']",
          "wait": 2500
        },
        {
          "click": "role=tab[name=/Books/]",
          "wait": 1500
        },
        {
          "click": "[aria-label='Place a hold on The Quiet Orchard']",
          "wait": 1500
        },
        {
          "click": "role=radio[name='Pine Hollow Elementary']",
          "wait": 300
        },
        {
          "fill": [
            "input[aria-label='Note for the librarian (optional)'], textarea[aria-label='Note for the librarian (optional)']",
            "Large print, please"
          ]
        },
        {
          "click": "role=button[name='Place hold']",
          "wait": 1500
        },
        {
          "click": "role=button[name='Done']",
          "wait": 1500
        },
        {
          "click": "role=tab[name=/Holds/]",
          "wait": 2000
        }
      ],
      "expect": [
        "The Quiet Orchard",
        "Pick up at Pine Hollow Elementary",
        "Requested",
        "A History of Tamarack County"
      ],
      "absent": [
        "Not sent yet"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "queue-waiting-saved",
      "path": "/holds",
      "storage": {
        "bookmobile-hold-queue": "{\"state\":{\"holds\":[{\"clientId\":\"phone-hold-0042\",\"bookId\":\"b11\",\"bookTitle\":\"The Ice Road Letters\",\"stopId\":\"s07\",\"stopName\":\"Lakeside Mobile Home Park\",\"note\":\"\",\"patronId\":\"p01\",\"status\":\"waiting\",\"attempts\":2,\"problem\":null}]},\"version\":0}"
      },
      "actions": [
        {
          "click": "role=link[name='Sign in']",
          "wait": 1500
        },
        {
          "fill": [
            "input[aria-label='Library card number']",
            "2145 0021"
          ]
        },
        {
          "fill": [
            "input[aria-label='PIN']",
            "4821"
          ]
        },
        {
          "click": "role=button[name='Sign in']",
          "wait": 2500
        },
        {
          "click": "role=tab[name=/Holds/]",
          "wait": 2500
        }
      ],
      "expect": [
        "The Ice Road Letters",
        "Pick up at Lakeside Mobile Home Park",
        "Requested"
      ],
      "absent": [
        "Not sent yet"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "nearest-explain",
      "path": "/",
      "actions": [
        {
          "click": "role=button[name='Find my nearest stop']",
          "wait": 1500
        }
      ],
      "expect": [
        "uses your location once, on this phone, to find the closest stop",
        "Your phone asks next."
      ],
      "selectors": {
        "role=button[name='Continue']": 1
      },
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "nearest-granted",
      "path": "/",
      "permissions": [
        "geolocation"
      ],
      "geolocation": {
        "latitude": 46.8792,
        "longitude": -91.4935
      },
      "actions": [
        {
          "click": "role=button[name='Find my nearest stop']",
          "wait": 2000
        },
        {
          "click": "role=button[name='Make this my stop']",
          "wait": 1000
        }
      ],
      "expect": [
        "Your nearest stop is Tamarack Middle School, about 400 m away.",
        "This is your stop.",
        "My stop"
      ],
      "absent": [
        "Your phone asks next."
      ],
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "nearest-blocked",
      "path": "/",
      "color_scheme": "dark",
      "actions": [
        {
          "click": "role=button[name='Find my nearest stop']",
          "wait": 1500
        },
        {
          "click": "role=button[name='Continue']",
          "wait": 2500
        },
        {
          "click": "role=button[name='Open Settings']",
          "wait": 1000
        }
      ],
      "expect": [
        "is not allowed to use your location",
        "There is no Settings app here.",
        "Check again",
        "8 stops this week"
      ],
      "absent": [
        "Finding where you are",
        "Your nearest stop is"
      ],
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    },
    {
      "app": "bookmobile-stops",
      "name": "wide-dark",
      "path": "/books",
      "width": 1024,
      "color_scheme": "dark",
      "expect": [
        "12 books",
        "The Lantern Keeper's Map"
      ],
      "axe": true,
      "axe_ignore": [
        "document-title"
      ]
    }
  ]
}
