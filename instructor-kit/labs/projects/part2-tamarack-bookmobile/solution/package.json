{
  "name": "bookmobile-stops",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ../../../node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "web": "expo start --web",
    "api": "node ../bookmobile-api/server.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "./jest.environment.js",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "fakeTimers": {
      "doNotFake": [
        "nextTick",
        "queueMicrotask"
      ]
    }
  }
}
