{
  "title": "Three silent mistakes, made loud: a picture, an icon table, a bottom bar",
  "lesson": "2.3",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "Tests:       4 failed, 1 passed, 5 total",
        "toHaveProp"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": "nonzero",
      "expect": [
        "error TS2820",
        "Did you mean '\"grid_view\"'?"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       5 passed, 5 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    },
    {
      "name": "solution-web",
      "dir": "solution",
      "cmd": "npx expo export --platform web --output-dir dist --clear",
      "exit": 0,
      "expect": [
        "Exported: dist"
      ],
      "timeout": 300
    }
  ]
}
