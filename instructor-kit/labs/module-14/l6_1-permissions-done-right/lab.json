{
  "title": "Voice notes, asked politely: permission steps, an ask-first gate, reading the answer again",
  "lesson": "6.1",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "Tests:       7 failed, 5 passed, 12 total"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": "nonzero",
      "expect": [
        "error TS2345",
        "Did you mean to call this expression?"
      ]
    },
    {
      "name": "starter-lint",
      "dir": "starter",
      "cmd": "npm run lint",
      "exit": 0,
      "expect": [
        "react-hooks/exhaustive-deps",
        "2 problems (0 errors, 2 warnings)"
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       12 passed, 12 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    }
  ]
}
