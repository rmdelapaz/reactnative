{
  "title": "Routes from files, params, and the way back",
  "lesson": "4.1",
  "tasks": 3,
  "runs": [
    {
      "name": "starter",
      "dir": "starter",
      "cmd": "npm test",
      "exit": "nonzero",
      "expect": [
        "No route named \"sites/[id]\" exists in nested children",
        "Tests:       6 failed, 1 passed, 7 total"
      ]
    },
    {
      "name": "starter-types",
      "dir": "starter",
      "cmd": "npm run typecheck",
      "exit": "nonzero",
      "expect": [
        "error TS2345: Argument of type 'string | string[] | undefined' is not assignable to parameter of type 'string'."
      ]
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "npm test",
      "exit": 0,
      "expect": [
        "Tests:       7 passed, 7 total"
      ]
    },
    {
      "name": "solution-types",
      "dir": "solution",
      "cmd": "npm run typecheck",
      "exit": 0,
      "absent": [
        "error TS"
      ]
    },
    {
      "name": "solution-lint",
      "dir": "solution",
      "cmd": "npm run lint",
      "exit": 0,
      "absent": [
        "problem"
      ]
    }
  ]
}
