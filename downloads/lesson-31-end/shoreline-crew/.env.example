# Where the app finds shoreline-api. Copy this file to .env.local and change it there,
# then restart Metro with: npx expo start --clear
#   Web preview, iOS Simulator:  http://localhost:4000
#   Android emulator:            http://10.0.2.2:4000
#   Expo Go on a phone:          your computer's address, such as http://192.168.1.42:4000
#                                (start the API with: node server.ts --host)
EXPO_PUBLIC_API_URL=http://localhost:4000
